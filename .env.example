# Grimyapper — environment variables
# Copy to .env.local for local dev. NEVER commit a real key.

# Required. Server-side only — this must never be prefixed with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Model used for all three LLM roles. Defaults to claude-haiku-4-5.
JUDGE_MODEL=claude-haiku-4-5

# Optional rate-limit tuning (defaults shown).
# Per-IP sliding window.
RATE_LIMIT_MAX=8
RATE_LIMIT_WINDOW_MS=60000
# Hard global ceiling on judgements per UTC day, per server instance.
DAILY_JUDGEMENT_CAP=1500
